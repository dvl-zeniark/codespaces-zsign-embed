---
import "../styles/global.css";

type Props = {
  title: string;
};

const { title } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: "/", label: "Dashboard", match: (p: string) => p === "/" },
  { href: "/documents", label: "Documents", match: (p: string) => p === "/documents" },
  { href: "/builder", label: "Builder", match: (p: string) => p.startsWith("/builder") },
  { href: "/signature-requests", label: "Signature requests", match: (p: string) => p === "/signature-requests" },
  { href: "/webhooks", label: "Webhooks", match: (p: string) => p === "/webhooks" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · ZSign Embed quickstart</title>
  </head>
  <body class="min-h-screen bg-zinc-100 text-zinc-950">
    <div class="flex min-h-screen">
      <aside class="w-56 shrink-0 border-r border-zinc-200 bg-white">
        <div class="border-b border-zinc-200 px-4 py-4">
          <p class="text-sm font-semibold tracking-tight">Embed quickstart</p>
          <p class="mt-1 text-xs text-zinc-500">Mint on the server, iframe in the browser</p>
        </div>
        <nav class="flex flex-col gap-1 p-3">
          {
            links.map((link) => {
              const active = link.match(path);
              return (
                <a
                  href={link.href}
                  class:list={[
                    "rounded-md px-3 py-2 text-sm no-underline transition-colors",
                    active
                      ? "bg-zinc-900 font-medium text-white"
                      : "text-zinc-700 hover:bg-zinc-100",
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>
      </aside>
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="border-b border-zinc-200 bg-white px-6 py-4">
          <h1 class="text-lg font-semibold tracking-tight">{title}</h1>
        </header>
        <main class="flex-1 px-6 py-5">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
