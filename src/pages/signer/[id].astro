---
import AppLayout from "../../layouts/AppLayout.astro";
export const prerender = false;
import { SignerPanel } from "../../components/SignerPanel";

const { id } = Astro.params;
const requestId = id?.trim() || "";
---

<AppLayout title="Signer">
  {
    !requestId ? (
      <p class="text-sm text-zinc-600">
        Missing request id. Or open{" "}
        <a href="/signer" class="underline">
          /signer
        </a>{" "}
        and pick a sent request.
      </p>
    ) : (
      <div class="space-y-3">
        <p class="text-sm text-zinc-600">
          Signer for <code class="text-xs">{requestId}</code> · mint:
          <code class="text-xs">POST /api/mint/signer/{requestId}</code>
        </p>
        <SignerPanel client:load initialRequestId={requestId} />
      </div>
    )
  }
</AppLayout>
