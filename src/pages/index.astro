---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Dashboard">
  <div class="space-y-6">
    <p class="max-w-2xl text-sm text-zinc-600">
      Each sidebar link is a real page. Open a screen file under
      <code class="text-xs">src/pages/</code>, follow its mint route under
      <code class="text-xs">src/pages/api/mint/</code>, then read
      <code class="text-xs">src/lib/zsign.ts</code>.
    </p>

    <div class="rounded-lg border border-zinc-200 bg-white p-4 text-sm">
      <p class="font-medium text-zinc-900">Connection</p>
      <p class="mt-1 text-xs text-zinc-500">
        Checks <code class="text-[11px]">GET /api/ping</code> →
        <code class="text-[11px]">pages/api/ping.ts</code> → ZSign
        <code class="text-[11px]">GET /external/ping</code>. Key stays on the server.
        Register the webhook URL below in ZSign Integrations (inbox lives on
        <a href="/webhooks" class="underline">Webhooks</a>).
      </p>
      <dl class="mt-3 space-y-2">
        <div>
          <dt class="text-xs font-medium text-zinc-500">Ping</dt>
          <dd id="ping-status" class="text-zinc-800">Checking...</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-zinc-500">Webhook receive URL</dt>
          <dd id="webhook-url" class="font-mono text-xs text-zinc-800">...</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-zinc-500">Base URL</dt>
          <dd id="ping-api-base" class="font-mono text-xs text-zinc-800">...</dd>
        </div>
      </dl>
    </div>

    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
      <p class="font-medium">Before you start</p>
      <p class="mt-1 text-amber-900">
        Paste your integration key in <code class="text-xs">.env.local</code> as
        <code class="text-xs">ZSIGN_API_KEY</code> (see <code class="text-xs">.env.example</code>).
        For webhooks, add <code class="text-xs">ZSIGN_WEBHOOK_SECRET</code> from Integrations.
        The full endpoint URL to register in ZSign is on the
        <a href="/webhooks" class="font-medium underline">Webhooks</a> page (not returned in API
        JSON responses). No key field in this UI —
        <code class="text-xs">src/lib/config.ts</code> reads env on the server.
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <a
        href="/documents"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Documents</p>
        <p class="mt-1 text-sm text-zinc-500">
          Upload PDFs + optional app context (directory)
        </p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>DocumentsPanel</code> → <code>api/mint/documents.ts</code>
        </p>
      </a>

      <a
        href="/builder"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Builder</p>
        <p class="mt-1 text-sm text-zinc-500">
          New (document dropdown) or resume (draft dropdown) + app context
        </p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>/builder</code> → <code>BuilderPanel</code>
        </p>
      </a>

      <a
        href="/signature-requests"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Signature requests</p>
        <p class="mt-1 text-sm text-zinc-500">
          Hub view + email scoping + hub hiding (not full directory)
        </p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>SignatureRequestsPanel</code> → <code>api/mint/signature-requests.ts</code>
        </p>
      </a>

      <a
        href="/signer"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Signer</p>
        <p class="mt-1 text-sm text-zinc-500">
          Pick a sent request from a dropdown
        </p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>/signer</code> → <code>SignerPanel</code>
        </p>
      </a>

      <a
        href="/webhooks"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Webhooks</p>
        <p class="mt-1 text-sm text-zinc-500">Read-only delivery inbox</p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>pages/webhooks.astro</code> → <code>api/webhooks/zsign.ts</code>
        </p>
      </a>
    </div>
  </div>
</AppLayout>

<script>
  const statusEl = document.getElementById("ping-status");
  const baseEl = document.getElementById("ping-api-base");
  const webhookEl = document.getElementById("webhook-url");

  if (webhookEl) {
    webhookEl.textContent = `${window.location.origin}/api/webhooks/zsign`;
  }

  fetch("/api/ping")
    .then(async (res) => {
      const body = await res.json();
      if (baseEl && body.apiBase) baseEl.textContent = body.apiBase;
      if (!res.ok) throw new Error(body.message || `HTTP ${res.status}`);
      if (statusEl) {
        statusEl.textContent = "API key works (GET /external/ping)";
        statusEl.className = "text-green-700";
      }
    })
    .catch((err) => {
      if (statusEl) {
        statusEl.textContent = err instanceof Error ? err.message : "Ping failed";
        statusEl.className = "text-red-600";
      }
    });
</script>
