---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Dashboard">
  <div class="space-y-6">
    <p class="max-w-2xl text-sm text-zinc-600">
      Each sidebar link is a real page. Open a screen file under
      <code class="text-xs">src/pages/</code>, follow its mint route under
      <code class="text-xs">src/pages/api/mint/</code>, then read
      <code class="text-xs">src/lib/zsign.ts</code>.
    </p>

    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
      <p class="font-medium">Before you start</p>
      <p class="mt-1 text-amber-900">
        Paste your integration key in <code class="text-xs">.env.local</code> as
        <code class="text-xs">ZSIGN_API_KEY</code> (see <code class="text-xs">.env.example</code>).
        For webhooks, add <code class="text-xs">ZSIGN_WEBHOOK_SECRET</code> from Integrations.
        No key field in this UI — <code class="text-xs">src/lib/config.ts</code> reads env on the server.
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <a
        href="/documents"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Documents</p>
        <p class="mt-1 text-sm text-zinc-500">Upload and manage PDFs</p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>pages/documents.astro</code> → <code>api/mint/documents.ts</code>
        </p>
      </a>

      <a
        href="/builder"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Builder (new)</p>
        <p class="mt-1 text-sm text-zinc-500">Start from a document id</p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>/builder?documentId=...</code> → <code>api/mint/builder.ts</code>
        </p>
      </a>

      <a
        href="/signature-requests"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Signature requests</p>
        <p class="mt-1 text-sm text-zinc-500">Signature request list</p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>pages/signature-requests.astro</code> → <code>api/mint/signature-requests.ts</code>
        </p>
      </a>

      <div class="rounded-lg border border-dashed border-zinc-300 bg-zinc-50 p-4">
        <p class="font-medium text-zinc-900">Builder (resume) / Signer</p>
        <p class="mt-1 text-sm text-zinc-500">
          Open by request id after you create or send a request in ZSign.
        </p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>/builder/[id]</code> · <code>/signer/[id]</code>
        </p>
      </div>

      <a
        href="/webhooks"
        class="rounded-lg border border-zinc-200 bg-white p-4 no-underline shadow-sm transition hover:border-zinc-300"
      >
        <p class="font-medium text-zinc-900">Webhooks</p>
        <p class="mt-1 text-sm text-zinc-500">Read-only delivery inbox</p>
        <p class="mt-2 text-xs text-zinc-400">
          <code>pages/webhooks.astro</code> → <code>api/webhooks/zsign.ts</code>
        </p>
      </a>
    </div>
  </div>
</AppLayout>
