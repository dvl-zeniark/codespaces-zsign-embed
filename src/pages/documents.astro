---
import AppLayout from "../layouts/AppLayout.astro";
import { DocumentsPanel } from "../components/DocumentsPanel";
---

<AppLayout title="Documents">
  <div class="space-y-3">
    <p class="text-sm text-zinc-600">
      Server mint:
      <code class="text-xs">POST /api/mint/documents</code> → ZSign
      <code class="text-xs">embed/documents</code>. Optional app context
      (<code class="text-xs">directory</code>) is configured below — see
      <code class="text-xs">pages/api/mint/documents.ts</code>.
    </p>
    <DocumentsPanel client:load />
  </div>
</AppLayout>
