---
import AppLayout from "../layouts/AppLayout.astro";
import { listWebhooks } from "../lib/inbox";

// Must be on-demand: Astro.url.origin is the live host (Codespaces / Docker),
// and the inbox is in-memory for this process — neither belongs in a static build.
export const prerender = false;

const events = listWebhooks();
const webhookUrl = new URL("/api/webhooks/zsign", Astro.url.origin).href;
---

<AppLayout title="Webhooks">
  <div class="space-y-4">
    <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-4">
      <p class="font-medium text-zinc-900">Register this URL in ZSign</p>
      <p class="mt-1 text-sm text-zinc-600">
        In <strong>ZSign &gt; Settings &gt; Integrations &gt; Webhooks</strong>, paste the full
        endpoint below.
      </p>
      <div class="mt-3 flex items-start gap-2">
        <pre
          class="flex-1 overflow-x-auto rounded border border-zinc-200 bg-white p-3 text-xs text-zinc-800"
        ><code id="webhook-url">{webhookUrl}</code></pre>
        <button
          type="button"
          id="copy-webhook-url"
          class="shrink-0 rounded border border-zinc-300 bg-white px-3 py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-50"
        >
          Copy
        </button>
      </div>
      <p class="mt-2 text-xs text-zinc-500">
        Relative path: <code>POST /api/webhooks/zsign</code>. Paste the signing secret in
        <code class="text-xs">.env.local</code> as
        <code class="text-xs">ZSIGN_WEBHOOK_SECRET</code>.
      </p>
    </div>

  {
    events.length === 0 ? (
      <p class="rounded-lg border border-dashed border-zinc-300 bg-zinc-50 p-4 text-sm text-zinc-500">
        No events yet. Send a test delivery from Integrations or complete a signature request.
      </p>
    ) : (
      <div class="overflow-hidden rounded-lg border border-zinc-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-zinc-200 bg-zinc-50 text-xs uppercase tracking-wide text-zinc-500">
            <tr>
              <th class="px-4 py-2 font-medium">Event</th>
              <th class="px-4 py-2 font-medium">Delivery id</th>
              <th class="px-4 py-2 font-medium">Received</th>
              <th class="px-4 py-2 font-medium">Payload</th>
            </tr>
          </thead>
          <tbody>
            {
              events.map((row) => (
                <tr class="border-b border-zinc-100 last:border-0">
                  <td class="px-4 py-2 font-medium text-zinc-900">{row.type}</td>
                  <td class="px-4 py-2 font-mono text-xs text-zinc-600">{row.id}</td>
                  <td class="px-4 py-2 text-xs text-zinc-500">{row.receivedAt}</td>
                  <td class="px-4 py-2 font-mono text-xs text-zinc-600">
                    {row.payloadSummary || "—"}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }
  </div>
</AppLayout>

<script>
  const copyButton = document.getElementById("copy-webhook-url");
  const webhookCode = document.getElementById("webhook-url");

  copyButton?.addEventListener("click", async () => {
    const text = webhookCode?.textContent?.trim();
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      copyButton.textContent = "Copied";
      setTimeout(() => {
        copyButton.textContent = "Copy";
      }, 2000);
    } catch {
      copyButton.textContent = "Failed";
      setTimeout(() => {
        copyButton.textContent = "Copy";
      }, 2000);
    }
  });
</script>
