---
import AppLayout from "../../layouts/AppLayout.astro";
import { BuilderPanel } from "../../components/BuilderPanel";

const documentId = Astro.url.searchParams.get("documentId")?.trim() || "";
---

<AppLayout title="Builder">
  <div class="space-y-3">
    <p class="text-sm text-zinc-600">
      Pick a document (or deep-link with
      <code class="text-xs">?documentId=</code>), optionally set app context, then
      mint:
      <code class="text-xs">POST /api/mint/builder</code> →
      <code class="text-xs">embed/signature-requests</code>.
    </p>
    <BuilderPanel client:load mode="new" initialDocumentId={documentId} />
  </div>
</AppLayout>
