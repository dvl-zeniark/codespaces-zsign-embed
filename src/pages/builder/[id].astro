---
import AppLayout from "../../layouts/AppLayout.astro";
export const prerender = false;
import { BuilderPanel } from "../../components/BuilderPanel";

const { id } = Astro.params;
const requestId = id?.trim() || "";
---

<AppLayout title="Builder">
  {
    !requestId ? (
      <p class="text-sm text-zinc-600">Missing request id.</p>
    ) : (
      <div class="space-y-3">
        <p class="text-sm text-zinc-600">
          Resume draft <code class="text-xs">{requestId}</code> · mint:
          <code class="text-xs">POST /api/mint/builder/{requestId}</code> with
          optional <code class="text-xs">directory</code> app context.
        </p>
        <BuilderPanel client:load mode="resume" requestId={requestId} />
      </div>
    )
  }
</AppLayout>
