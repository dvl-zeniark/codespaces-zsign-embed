---
import AppLayout from "../../layouts/AppLayout.astro";
export const prerender = false;
import { BuilderPanel } from "../../components/BuilderPanel";

const { id } = Astro.params;
const requestId = id?.trim() || "";
---

<AppLayout title="Builder">
  {
    !requestId ? (
      <p class="text-sm text-zinc-600">
        Missing request id. Or open{" "}
        <a href="/builder" class="underline">
          /builder
        </a>{" "}
        and use Resume draft.
      </p>
    ) : (
      <div class="space-y-3">
        <p class="text-sm text-zinc-600">
          Resume draft <code class="text-xs">{requestId}</code> · mint:
          <code class="text-xs">POST /api/mint/builder/{requestId}</code>
        </p>
        <BuilderPanel
          client:load
          forceMode="resume"
          initialRequestId={requestId}
        />
      </div>
    )
  }
</AppLayout>
